import { Signal, append, createAsyncMemo, createIntSignal, isPending, latest, render } from "solidlil";

func()->void dispose = render("#app", (Element root) => {
  Signal<int> userId = createIntSignal(1);
  Signal<string> profile = createAsyncMemo(
    "",
    () => delayString(`Ada Lovelace #${userId.read()}`, 180),
    (string a, string b) => a == b
  );
  Element view = (
    <div class="stack">
      <h2>Async memo</h2>
      <button class="primary" onClick={() => { userId.write(userId.read() + 1); }}>
        Next profile
      </button>
      <div class="card">
        <p class="muted">{pendingLine(profile)}</p>
        <Loading fallback={<p class="muted">Loading profile…</p>}>
          <h3 class={{ stale: isPending(profile) }}>{profile.read()}</h3>
        </Loading>
      </div>
    </div>
  );
  append(root, view);
});

string pendingLine(Signal<string> profile) {
  string state = "ready";
  if (isPending(profile)) {
    state = "pending";
  }
  return `${state} · latest ${latest(profile)}`;
}
