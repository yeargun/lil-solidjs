import { Signal, append, createStringSignal, render } from "solidlil";

class NodeRef {
  Element? node;

  init() {
    this.node = null;
  }
}

func()->void dispose = render("#app", (Element root) => {
  Signal<string> name = createStringSignal("Ada");
  NodeRef field = new NodeRef();
  Element view = (
    <div class="stack">
      <h2>Form binding</h2>
      <input
        ref={(Element node) => { field.node = node; }}
        value={name.read()}
        onInput={() => {
          Element? node = field.node;
          if (node != null) {
            name.write(node.value);
          }
        }}
      />
      <p>{`Hello, ${name.read()}`}</p>
    </div>
  );
  append(root, view);
});
